{
  "name": "light-plan-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web UI for light-plan boards: the editor `lpm ui` serves, and the read-only viewer `lpm export` publishes. Both ship as static assets.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "build:all": "npm run build && npm run build:viewer",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@xyflow/svelte": "^1.2.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
